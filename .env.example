# Empty, nonfunctional placeholders. bootstrap generates local-only secrets without printing.
APP_ENV=local
CONTROL_DJANGO_SECRET_KEY=
VAULT_DJANGO_SECRET_KEY=
CONTROL_DB_PASSWORD=
VAULT_DB_PASSWORD=
CONTROL_DB_ADMIN_PASSWORD=
VAULT_DB_ADMIN_PASSWORD=
# See docs/local-development.md for runtime variables and local ports.

# Phase 3 local-only keys (generated by bootstrap/migrate, never print them):
CONTROL_AUTH_DATA_KEY=
VAULT_AUTH_DATA_KEY=
CONTROL_COMMAND_PRIVATE_KEY=
VAULT_COMMAND_PUBLIC_KEY=
VAULT_PROJECTION_PRIVATE_KEY=
CONTROL_PROJECTION_PUBLIC_KEY=
# Runtime per-service names: AUTH_DATA_KEY, COMMAND_KEY, PROJECTION_KEY,
# PUBLIC_ORIGIN, CONTROL_ORIGIN, VAULT_ORIGIN. See docs/api-contracts.md.

# Phase 4: dedicated local wishlist AES-256 key, generated without display.
VAULT_WISHLIST_KEY=
# Vault runtime: WISHLIST_KEYS (JSON key-id -> base64 32-byte key),
# WISHLIST_ACTIVE_KEY=v1, MERCHANT_ALLOWLIST (optional operator-local JSON path).

# Phase 5: separate local draw master and backup encryption keys.
VAULT_DRAW_MASTER_KEY=
VAULT_BACKUP_KEY=
# Vault runtime: DRAW_MASTER_KEYS (JSON), DRAW_ACTIVE_KEY=v1.
# Operator command only: BACKUP_ENCRYPTION_KEY, BACKUP_DB_USER,
# BACKUP_DB_PASSWORD, PG_BIN. Never inject these backup/admin variables into apps.

# Phase 6: generated JSON version map for the local master keys, no real values here.
# VAULT_MASTER_KEYS replaces the single VAULT_DRAW_MASTER_KEY runtime mapping.
# Preserve the original v1 and all versions needed by backups.
VAULT_MASTER_KEYS=
VAULT_ACTIVE_MASTER_KEY=
# Vault runtime names remain DRAW_MASTER_KEYS / DRAW_ACTIVE_KEY for compatibility.
# WISHLIST_KEYS remains read-only for legacy revisions/backups until retirement is qualified.

# Phase 7. Prefix each name below with CONTROL_ or VAULT_ in local .env.
# Separate service credentials; never commit live values. Defaults remain Mailpit simulation.
# MAIL_PROVIDER=mailpit|resend|zoho, MAIL_LIVE_ENABLED=false,
# MAIL_TEST_RECIPIENTS (authorised inbox list), NOTIFICATION_FROM_EMAIL.
# Resend: RESEND_API_KEY, RESEND_WEBHOOK_SECRET, RESEND_DOMAIN_ID,
# MAIL_DNS_VERIFIED=false, MAIL_TRACKING_DISABLED=false.
# Zoho EU: SMTP_HOST, SMTP_PORT=465, SMTP_USE_SSL=true, SMTP_USE_TLS=false,
# SMTP_USERNAME, SMTP_PASSWORD. Alternative TLS: port 587 / SSL false / TLS true.
# See docs/runbooks/notifications.md. gtech .env path is pending; no password copied.

# Native WSGI: bounded connection reuse in seconds, 0 disables (range 0..300).
CONTROL_DB_CONN_MAX_AGE=60
VAULT_DB_CONN_MAX_AGE=60

# Phase 10: generated locally by migrate/operator; never share these between services.
CONTROL_OPERATIONS_KEY=
VAULT_OPERATIONS_KEY=
CONTROL_BACKUP_KEY=
# VAULT_BACKUP_KEY is already declared above.
# Operator process only: OPERATIONS_DIRECTORY, OPERATIONS_KEY, BACKUP_ENCRYPTION_KEY,
# BACKUP_DB_USER, BACKUP_DB_PASSWORD, PG_BIN. Keep journal outside database snapshots.
# Before starting a restored web/worker process: FORCE_MAINTENANCE=true.

# Local runner only; NOEL_<name> environment variables override these non-secret options.
# Reuse VAULT_DB_PORT=55432 for an existing Windows cluster if appropriate.
CONTROL_DB_PORT=55431
VAULT_DB_PORT=55433
CONTROL_WEB_PORT=8001
VAULT_WEB_PORT=8002
CONTROL_BROWSER_PORT=8201
VAULT_BROWSER_PORT=8202
MAILPIT_HTTP_PORT=18025
MAILPIT_SMTP_PORT=11025
# PG_BIN=/usr/lib/postgresql/17/bin
# Native web defaults remain one process x four threads (Windows compatible).
# Qualified Ubuntu mode: set WEB_PROCESSES=2 and WEB_THREADS=2 locally.
# WEB_PROCESSES=1
# WEB_THREADS=4
